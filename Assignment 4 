return 1;
}
int rollNo; string name;
float marks;
int count = 0;
// Table Header
cout << "\n----- Student Records -----\n";
cout << left << setw(10) << "RollNo"
<< setw(15) << "Name"
<< setw(10) << "Marks" << endl;
cout << "----------------------------------\n";
// Read file until EOF
while (file >> rollNo >> name >> marks) {
cout << left << setw(10) << rollNo
<< setw(15) << name
<< setw(10) << marks << endl;
count++; // increment record count
} // Close file
file.close();
// Display total records
cout << "\nTotal Records: " << count << endl;
return 0;
}

Question 3: UPDATE Operation

#include <iostream>
#include <fstream>
using namespace std;
int main() {
fstream file;
// Open file for both reading and writing
file.open("students.txt", ios::in | ios::out);
if (!file) {
cout << "Error: Unable to open file!" << endl;
return 1;
}
int searchRoll;
float newMarks;
cout << "Enter Roll No to update: ";
cin >> searchRoll; cout << "Enter new Marks: ";
cin >> newMarks;
int rollNo;
string name;
float marks;
bool found = false;
// Store current position
streampos pos;
// Read file record by record
while (file >> rollNo >> name >> marks) {
// Save position BEFORE writing next record
pos = file.tellg();
if (rollNo == searchRoll) {
found = true;
// Move write pointer back to start of this record file.seekp(pos - streamoff(name.length() + 20));
// Overwrite record (same format)
file << rollNo << " " << name << " " << newMarks;
cout << "Record updated successfully!" << endl;
break;
}
}
if (!found) {
cout << "Roll No not found!" << endl;
}
file.close();
return 0;
}

 Question 4: DELETE Operation

#include <iostream>
#include <fstream>
#include <cstdio> // for remove() and rename()
using namespace std;
int main() {
ifstream file; // original file (read)
ofstream tempFile; // temporary file (write)
file.open("students.txt");
tempFile.open("temp.txt"); // Check if file opened
if (!file || !tempFile) {
cout << "Error opening file!" << endl;
return 1;
}
int searchRoll;
cout << "Enter Roll No to delete: ";
cin >> searchRoll;
int rollNo;
string name;
float marks;
bool found = false;
// Read original file and copy data except target
while (file >> rollNo >> name >> marks) {
if (rollNo == searchRoll) {
found = true; // skip this record } else {
tempFile << rollNo << " " << name << " " << marks << endl;
}
}
file.close();
tempFile.close();
// Delete original file
remove("students.txt");
// Rename temp file to original file name
rename("temp.txt", "students.txt");
if (found) {
cout << "Record deleted successfully!" << endl;
} else {
cout << "Roll No not found!" << endl;
}
return 0; }